{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tuya2ildevice:rule-pack:1",
  "title": "Tuya portable rule pack version 1",
  "type": "object",
  "required": [
    "version",
    "platforms",
    "entities",
    "unused",
    "templates",
    "functions",
    "quirks",
    "units",
    "host_units",
    "maps",
    "features",
    "constants",
    "cover_defaults",
    "cover_switches",
    "motion_property",
    "strategies"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "table",
          "categories"
        ],
        "properties": {
          "table": {
            "type": "string"
          },
          "categories": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/entity"
      }
    },
    "unused": {
      "type": "object",
      "required": [
        "role",
        "variants"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unused"
          }
        }
      },
      "additionalProperties": false
    },
    "layout_common": {
      "type": "object"
    },
    "identity_defaults": {
      "type": "object"
    },
    "templates": {
      "type": "object"
    },
    "functions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/function"
      }
    },
    "quirks": {
      "type": "object"
    },
    "units": {
      "type": "object"
    },
    "host_units": {
      "type": "object"
    },
    "rw_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "maps": {
      "type": "object"
    },
    "features": {
      "type": "object"
    },
    "constants": {
      "type": "object",
      "properties": {
        "manufacturer": {
          "type": "string"
        },
        "vacuum_return_mode": {
          "type": "string",
          "minLength": 1
        },
        "alarm_non_triggering_messages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "temperature_unit_dp": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cover_defaults": {
      "type": "object"
    },
    "cover_switches": {
      "type": "object"
    },
    "motion_property": {
      "type": "object"
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "wind": {
      "type": "object"
    },
    "electricity": {
      "type": "object"
    },
    "meter_alarms": {
      "type": "object"
    },
    "overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entity": {
      "type": "object",
      "properties": {
        "params": {
          "type": "object"
        },
        "composite": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "expose": {
          "type": "boolean"
        },
        "update_all": {
          "type": "boolean"
        },
        "hazard": {},
        "role_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "cover": {
          "$ref": "#/$defs/cover"
        },
        "variants": {},
        "state": {},
        "actions": {
          "type": "object"
        },
        "layout": {},
        "finish": {}
      },
      "additionalProperties": false
    },
    "cover": {
      "type": "object",
      "required": [
        "position",
        "target",
        "instruction",
        "tilt",
        "words"
      ],
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target": {
          "type": "string"
        },
        "instruction": {
          "type": "string"
        },
        "tilt": {
          "type": "string"
        },
        "words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "unused": {
      "type": "object",
      "required": [
        "when",
        "platform",
        "steps"
      ],
      "properties": {
        "when": {},
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "steps": {}
      },
      "additionalProperties": false
    },
    "function": {
      "type": "object",
      "required": [
        "params",
        "body"
      ],
      "properties": {
        "params": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "body": {}
      },
      "additionalProperties": false
    }
  }
}
